{
  "version": 2,
  "builds": [
    {
      "src": "front_crm/package.json",
      "use": "@vercel/angular"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NG_APP_API_URL": "@vercel_api_url",
    "NG_APP_ALLOWED_ORIGINS": "@vercel_allowed_origins"
  }
}
