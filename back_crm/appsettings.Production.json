{
  "ConnectionStrings": {
    "DefaultConnection": "__SET_IN_ENV__",
    "CompacConnection": "__SET_IN_ENV__"
  },
  "JwtSettings": {
    "SecretKey": "__SET_IN_ENV__",
    "Issuer": "CRM-API",
    "Audience": "CRM-Client",
    "ExpiryInMinutes": 60
  },
  "SmtpSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "CRM",
    "SenderEmail": "__SET_IN_ENV__",
    "Username": "__SET_IN_ENV__",
    "Password": "__SET_IN_ENV__"
  },
  "GmailSettings": {
    "ClientId": "__SET_IN_ENV__",
    "ClientSecret": "__SET_IN_ENV__",
    "RefreshToken": "__SET_IN_ENV__",
    "SenderEmail": "__SET_IN_ENV__",
    "UseGmailApi": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsSettings": {
    "AllowedOrigins": [
      "https://tu-frontend-vercel.app"
    ]
  },
  "FileStorage": {
    "UploadPath": "CRM/uploads",
    "MaxFileSizeMB": 10,
    "WebPQuality": 80,
    "MaxImageWidth": 1920,
    "MaxImageHeight": 1080
  }
}
