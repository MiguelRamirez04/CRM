FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY back_crm.csproj ./
RUN dotnet restore

COPY . ./
RUN dotnet publish back_crm.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

RUN mkdir -p logs

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

COPY --from=build /app/publish ./

ENTRYPOINT ["dotnet", "back_crm.dll"]